{# 文件夹模式模板 - CSS 内嵌、图片引用相对路径 #}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ model.name }}{% if version %} - {{ version.name }}{% endif %}</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: "Microsoft YaHei UI", "Microsoft YaHei", "PingFang SC", sans-serif;
            background: #f5f5f5; color: #333; line-height: 1.6;
            max-width: 1200px; margin: 0 auto; padding: 20px;
        }
        .header { text-align: center; margin-bottom: 30px; }
        .header h1 { font-size: 28px; margin-bottom: 8px; color: #1a1a1a; }
        .header .meta { font-size: 14px; color: #666; }
        .header .meta span { margin: 0 8px; }
        .cover { text-align: center; margin-bottom: 24px; }
        .cover img { max-width: 100%; max-height: 400px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
        .section { background: #fff; border-radius: 8px; padding: 20px; margin-bottom: 20px; box-shadow: 0 1px 4px rgba(0,0,0,0.06); }
        .section h2 { font-size: 20px; margin-bottom: 12px; border-bottom: 2px solid #0078D4; padding-bottom: 8px; color: #0078D4; }
        .info-table { width: 100%; border-collapse: collapse; }
        .info-table td { padding: 8px 12px; border-bottom: 1px solid #eee; }
        .info-table td:first-child { font-weight: 600; width: 140px; color: #555; }
        .params-table { width: 100%; border-collapse: collapse; }
        .params-table td { padding: 8px 12px; border-bottom: 1px solid #eee; }
        .params-table td:first-child { font-weight: 600; width: 140px; color: #555; }
        .tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px; }
        .tag { background: #e3f2fd; color: #0078D4; padding: 4px 12px; border-radius: 16px; font-size: 13px; }
        .trigger-words { display: flex; flex-wrap: wrap; gap: 6px; }
        .trigger-word { background: #fff3e0; color: #e65100; padding: 3px 10px; border-radius: 4px; font-size: 13px; }
        .gallery { display: flex; flex-direction: column; gap: 20px; }
        .gallery-item { display: flex; gap: 20px; background: #fff; border-radius: 8px; overflow: hidden; box-shadow: 0 1px 4px rgba(0,0,0,0.06); }
        .gallery-item .img-container { flex-shrink: 0; width: 40%; max-width: 500px; }
        .gallery-item .img-container img { width: 100%; height: auto; display: block; }
        .gallery-item .meta-panel { flex: 1; padding: 16px; display: flex; flex-direction: column; }
        .gallery-item .meta-panel h4 { font-size: 14px; margin-bottom: 10px; color: #333; border-bottom: 1px solid #eee; padding-bottom: 6px; }
        .gallery-item .meta-row { margin-bottom: 8px; font-size: 13px; }
        .gallery-item .meta-row .label { display: inline-block; width: 100px; font-weight: 600; color: #666; vertical-align: top; }
        .gallery-item .meta-row .value { color: #333; word-break: break-all; }
        .gallery-item .prompt-box { background: #fafafa; border-radius: 6px; padding: 10px; margin-top: 8px; font-size: 12px; line-height: 1.5; color: #444; }
        .gallery-item .prompt-box strong { color: #0078D4; }
        .gallery-item .negative-box { background: #fef2f2; border-radius: 6px; padding: 10px; margin-top: 8px; font-size: 12px; line-height: 1.5; color: #444; }
        .gallery-item .negative-box strong { color: #dc2626; }
        .params-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 8px; margin-top: 12px; }
        .description { line-height: 1.8; }
        .description h1, .description h2, .description h3 { margin: 16px 0 8px; }
        .description p { margin-bottom: 8px; }
        .description img { max-width: 100%; border-radius: 4px; }
        .description pre { background: #f5f5f5; padding: 12px; border-radius: 4px; overflow-x: auto; }
        .description code { font-family: Consolas, monospace; }
        .file-list { list-style: none; }
        .file-list li { padding: 6px 0; border-bottom: 1px solid #eee; display: flex; justify-content: space-between; }
        .file-list .file-size { color: #999; }
        @media (max-width: 768px) {
            body { padding: 10px; }
            .header h1 { font-size: 22px; }
            .gallery { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); }
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>{{ model.name }}</h1>
        <div class="meta">
            {% if author %}<span>作者: {{ author }}</span>{% endif %}
            {% if model.type %}<span>类型: {{ model.type }}</span>{% endif %}
            {% if version and version.base_model %}<span>基础模型: {{ version.base_model }}</span>{% endif %}
            {% if version %}<span>版本: {{ version.name }}</span>{% endif %}
        </div>
    </div>

    {% if cover_image %}
    <div class="cover">
        <img src="{{ cover_image }}" alt="{{ model.name }}">
    </div>
    {% endif %}

    {# 1. 模型详细参数 #}
    <div class="section">
        <h2>模型详细参数</h2>
        <table class="info-table">
            <tbody>
                {% if files and files[0].name %}
                <tr><td>文件名</td><td>{{ files[0].name }}</td></tr>
                {% endif %}
                {% if version and version.base_model %}
                <tr><td>Base Model</td><td>{{ version.base_model }}</td></tr>
                {% endif %}
                {% if files and files[0].size_display %}
                <tr><td>文件大小</td><td>{{ files[0].size_display }}</td></tr>
                {% endif %}
                {% if files and files[0].sha256 %}
                <tr><td>SHA256</td><td style="font-family: Consolas, monospace; word-break: break-all;">{{ files[0].sha256 }}</td></tr>
                {% endif %}
                {% if trigger_words %}
                <tr>
                    <td>Trigger Words</td>
                    <td>
                        <div class="trigger-words">
                        {% for word in trigger_words %}
                            <span class="trigger-word">{{ word }}</span>
                        {% endfor %}
                        </div>
                    </td>
                </tr>
                {% endif %}
                {% if author %}
                <tr><td>作者</td><td>{{ author }}</td></tr>
                {% endif %}
                {% if model.stats and model.stats.downloadCount is defined %}
                <tr><td>下载量</td><td>{{ model.stats.downloadCount }}</td></tr>
                {% endif %}
                {% if model.allow_commercial_use %}
                <tr><td>License</td><td>{{ model.allow_commercial_use }}</td></tr>
                {% endif %}
                {% if version and version.download_url %}
                <tr>
                    <td>下载链接</td>
                    <td><a href="{{ version.download_url }}" target="_blank">{{ version.download_url }}</a></td>
                </tr>
                {% endif %}
                {% if model.id %}
                <tr>
                    <td>CivitAI 页面</td>
                    <td><a href="https://civitai.com/models/{{ model.id }}{% if version and version.id %}?modelVersionId={{ version.id }}{% endif %}" target="_blank">https://civitai.com/models/{{ model.id }}</a></td>
                </tr>
                {% endif %}
            </tbody>
        </table>
    </div>

    {# 2. 模型描述 (紧跟模型详细参数下面) #}
    {% if description_html %}
    <div class="section">
        <h2>模型描述</h2>
        <div class="description">
            {{ description_html | safe }}
        </div>
    </div>
    {% endif %}

    {# 2.1 版本描述（About this version） #}
    {% if version_description_html %}
    <div class="section">
        <h2>关于版本</h2>
        <div class="description">
            {{ version_description_html | safe }}
        </div>
    </div>
    {% endif %}

    {% if params %}
    <div class="section">
        <h2>推荐参数</h2>
        <table class="params-table">
            <tbody>
                {% for key, value in params.items() %}
                <tr><td>{{ key }}</td><td>{{ value }}</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% endif %}

    {% if tags %}
    <div class="section">
        <h2>标签</h2>
        <div class="tags">
            {% for tag in tags %}
            <span class="tag">{{ tag }}</span>
            {% endfor %}
        </div>
    </div>
    {% endif %}

    {% if files %}
    <div class="section">
        <h2>文件信息</h2>
        <ul class="file-list">
            {% for file in files %}
            <li>
                <span>{{ file.name }}</span>
                <span class="file-size">{{ file.size_display }}</span>
            </li>
            {% endfor %}
        </ul>
    </div>
    {% endif %}

    {# 3. 预览图片区域 (最后) #}
    {% if gallery_images %}
    <div class="section">
        <h2>示例图片</h2>
        <div class="gallery">
            {% for img in gallery_images %}
            <div class="gallery-item">
                <div class="img-container">
                    <img src="{{ img.src }}" alt="图片 {{ loop.index }}" loading="lazy" referrerpolicy="no-referrer">
                </div>
                <div class="meta-panel">
                    <h4>图片 {{ loop.index }} - Generation Data</h4>
                    {% if img.meta %}
                        {% if img.meta.prompt %}
                        <div class="prompt-box">
                            <strong>Prompt:</strong><br>{{ img.meta.prompt }}
                        </div>
                        {% endif %}
                        {% if img.meta.negativePrompt %}
                        <div class="negative-box">
                            <strong>Negative Prompt:</strong><br>{{ img.meta.negativePrompt }}
                        </div>
                        {% endif %}
                        {% if img.meta.sampler or img.meta.cfgScale or img.meta.steps or img.meta.seed or img.meta.scheduler or img.meta.size or img.meta.model %}
                        <div class="params-grid">
                            {% if img.meta.sampler %}
                            <div class="meta-row"><span class="label">Sampler</span><span class="value">{{ img.meta.sampler }}</span></div>
                            {% endif %}
                            {% if img.meta.cfgScale %}
                            <div class="meta-row"><span class="label">CFG Scale</span><span class="value">{{ img.meta.cfgScale }}</span></div>
                            {% endif %}
                            {% if img.meta.steps %}
                            <div class="meta-row"><span class="label">Steps</span><span class="value">{{ img.meta.steps }}</span></div>
                            {% endif %}
                            {% if img.meta.seed %}
                            <div class="meta-row"><span class="label">Seed</span><span class="value">{{ img.meta.seed }}</span></div>
                            {% endif %}
                            {% if img.meta.scheduler %}
                            <div class="meta-row"><span class="label">Scheduler</span><span class="value">{{ img.meta.scheduler }}</span></div>
                            {% endif %}
                            {% if img.meta.size %}
                            <div class="meta-row"><span class="label">Size</span><span class="value">{{ img.meta.size }}</span></div>
                            {% endif %}
                            {% if img.meta.model %}
                            <div class="meta-row"><span class="label">Model</span><span class="value">{{ img.meta.model }}</span></div>
                            {% endif %}
                            {% if img.meta.clipSkip %}
                            <div class="meta-row"><span class="label">Clip Skip</span><span class="value">{{ img.meta.clipSkip }}</span></div>
                            {% endif %}
                        </div>
                        {% endif %}
                    {% else %}
                        <p style="color: #999; font-size: 13px;">No generation data available</p>
                    {% endif %}
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
    {% endif %}

    <div class="section" style="text-align: center; color: #999; font-size: 12px;">
        <p>由 CivitAI 模型管理工具生成 | {{ generated_at }}</p>
    </div>
</body>
</html>
